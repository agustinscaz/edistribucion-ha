{
  "config": {
    "step": {
      "user": {
        "title": "Connect to the e-distribución add-on",
        "description": "Enter the address of the `edistribucion` add-on (defaults to the same Home Assistant instance).",
        "data": {
          "host": "Host",
          "port": "Port"
        }
      },
      "zeroconf_confirm": {
        "title": "e-distribución add-on found on the network",
        "description": "An e-distribución add-on was found at {host}:{port}. Do you want to add it?"
      }
    },
    "error": {
      "cannot_connect": "Could not connect to the add-on. Check that it's started and the host/port are correct."
    },
    "abort": {
      "already_configured": "That add-on is already configured.",
      "cannot_connect": "Could not connect to the add-on found on the network."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "e-distribución options: general settings",
        "description": "Only the update interval is global. After this step, you'll configure each of your {num_supplies} supply points separately: tariff type, power and energy prices, PVPC zone, and surplus compensation — all per supply point, since each contract can differ. Contracted power (kW) isn't asked for: it's read automatically from your e-distribución contract.",
        "data": {
          "scan_interval": "Update interval (minutes)"
        }
      },
      "supply_point": {
        "title": "Supply point {position}/{total}: {cups}",
        "description": "{address} ({estado})\n\nChoose whether to track this supply point, set an alias, and pick the tariff type (fixed/time-of-use/pvpc), the IEE and VAT percentages to apply, the power term price, the energy prices for the chosen tariff, surplus compensation, and (if using pvpc) the zone. Contracted power (kW) is read automatically from e-distribución — no need to type it in.\n\nTomorrow's pvpc prices are published around 20:15 the day before — no key or signup needed, it uses REE's public price file.",
        "data": {
          "track": "Track this supply point",
          "alias": "Alias (optional)",
          "tariff_type": "Tariff type: fixed / time-of-use / pvpc",
          "iee_percent": "IEE (electricity excise tax) to apply (%)",
          "iva_percent": "VAT to apply (%)",
          "price_power_punta": "Peak power price (€/kW/day)",
          "price_power_valle": "Off-peak power price (€/kW/day)",
          "fixed_price": "Fixed price (€/kWh, if tariff is 'fixed')",
          "price_punta": "Peak price (€/kWh, if tariff is 'time-of-use')",
          "price_llano": "Flat price (€/kWh, if tariff is 'time-of-use')",
          "price_valle": "Off-peak price (€/kWh, if tariff is 'time-of-use')",
          "holiday_region": "Holiday region (if tariff is 'time-of-use'): a weekday holiday counts as off-peak",
          "surplus_compensation": "Surplus compensation",
          "surplus_price": "Compensation price (€/kWh, if enabled)",
          "pvpc_zone": "PVPC zone (if tariff is 'pvpc'): Peninsula/Balearic Islands/Canary Islands, or Ceuta and Melilla"
        }
      }
    },
    "abort": {
      "cannot_connect": "Could not connect to the add-on to read your supply points — no changes were saved. Try again in a few seconds."
    }
  },
